<img src="https://tastypoll.app.com/img/favicon.png" alt="Logo" style="width:150px; height:auto;">
<h2>¡Gracias por participar en la encuesta "{{nombreEncuesta}}"!</h2>

<p>{{descripcionEncuesta}}</p>
<h3>Top alimentos más votados:</h3>

<ul>
  {{#each topAlimentos}}
    <li>
      <img src="{{urlImagen}}" alt="{{nombre}}" style="width:50px; height:auto; vertical-align:middle; margin-right:10px;">
      {{nombre}} - {{votos}} votos
    </li>
  {{/each}}
</ul>